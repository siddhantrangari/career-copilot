{
  "manifest_version": 3,
  "name": "Career Copilot Autofill",
  "version": "1.0.0",
  "description": "Fills job application forms with the answers and Studio resume PDF prepared in Career Copilot. You review and press Submit — it never submits.",
  "permissions": ["storage"],
  "host_permissions": ["https://career.myagentfirm.com/*", "http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Career Copilot Autofill", "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": [
        "https://boards.greenhouse.io/*", "https://job-boards.greenhouse.io/*", "https://*.greenhouse.io/*",
        "https://jobs.lever.co/*", "https://jobs.ashbyhq.com/*", "https://apply.workable.com/*",
        "https://jobs.smartrecruiters.com/*", "https://*.myworkdayjobs.com/*"
      ],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
