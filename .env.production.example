PORT=4005
NODE_ENV=production

# Isolated PostgreSQL Docker Configuration (Host Port 5438)
CAREER_COPILOT_DB_PORT=5438
DB_HOST=127.0.0.1
DB_USER=postgres
DB_PASSWORD=career_secret_2026
DB_NAME=career_copilot_db
DATABASE_URL=postgresql://postgres:career_secret_2026@127.0.0.1:5438/career_copilot_db

# AI Provider Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.6-sol
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MAX_TOKENS=8000

# Client API target (proxied directly via nginx at /api)
VITE_API_BASE_URL=/api
