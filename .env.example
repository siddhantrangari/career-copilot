PORT=4010
NODE_ENV=development

# ── PostgreSQL (same instance/credentials as the original career-copilot project,
#    separate database so the two apps never clobber each other) ──
CAREER_COPILOT_DB_PORT=5438
DB_HOST=127.0.0.1
DB_USER=postgres
DB_PASSWORD=career_secret_2026
DB_NAME=career_copilot_os
DATABASE_URL=postgresql://postgres:career_secret_2026@127.0.0.1:5438/career_copilot_os

# ── AI providers (failover chain, first configured wins) ──
AI_PROVIDER_ORDER=mesh,openai
AI_MAX_TOKENS=8000

# MeshAPI — OpenAI-compatible gateway (primary)
MESH_API_KEY=your_mesh_key_here
MESH_MODEL=anthropic/claude-sonnet-4-6
MESH_BASE_URL=https://api.meshapi.ai/v1

# Live web search (grounds research + WIN docs)
RESEARCH_LIVE_SEARCH=true
MESH_SEARCH_MODEL=perplexity/sonar-pro
RESEARCH_MAX_AGE_DAYS=7

# OpenAI (fallback — key currently out of credits)
OPENAI_API_KEY=sk-proj-your-key
OPENAI_MODEL=gpt-5.6-sol
OPENAI_BASE_URL=https://api.openai.com/v1

# ── Interview simulator ──
# Voice is free by default (browser speech synthesis); a paid voice is opt-in
# per interview from the UI. Speech recognition always runs free in the browser.
TTS_PROVIDER=browser
TTS_MESH_MODEL=x-ai/tts-v1
INTERVIEW_TURN_MODEL=openai/gpt-5.6-luna
INTERVIEW_PLAN_MODEL=openai/gpt-5.6-luna
INTERVIEW_REPORT_MODEL=openai/gpt-5.6-luna
# ELEVENLABS_API_KEY=
# Swap either to anthropic/claude-sonnet-4-6 for more depth at ~27x the cost.

# ── Cloudflare R2 (interview recordings) ──
# Unset = recordings stay on the VPS and remain fully playable.
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_r2_key
R2_SECRET_ACCESS_KEY=your_r2_secret
R2_BUCKET=career-copilot
R2_PREFIX=interviews

# ── Job discovery agent ──
# Polls public Greenhouse/Lever/Ashby JSON boards. Free, so the interval can
# be short. Set DISCOVERY_ENABLED=false to stop the scheduler.
DISCOVERY_ENABLED=true
DISCOVERY_INTERVAL_HOURS=6
DISCOVERY_MIN_RELEVANCE=40

# ── Morning digest (Telegram) ──
# One message a day: interviews this week, fresh high-match roles (72h) and
# follow-ups due. Stays silent until both Telegram values are set.
# Setup: create a bot with @BotFather, send it any message, then open
# Job Discovery → Morning digest → "Find my chat id".
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DIGEST_ENABLED=true
DIGEST_HOUR=8
DIGEST_MINUTE=0
DIGEST_TZ=Asia/Kolkata
DIGEST_MIN_RELEVANCE=75
DIGEST_MAX_JOBS=10

# ── Telegram assistant ──
# Chat with the whole app from the same bot. Answers TELEGRAM_CHAT_ID only.
BOT_ENABLED=true
BOT_MODEL=openai/gpt-5.6-luna
BOT_MAX_TOOL_ROUNDS=8
BOT_HISTORY_MESSAGES=12

# ── Single-user auth ──
JWT_SECRET=change-me
APP_USER_EMAIL=siddhantrangari@gmail.com
APP_USER_PASSWORD=change-me
